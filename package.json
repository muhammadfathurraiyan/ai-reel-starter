{
  "name": "ai-reel-starter",
  "version": "1.0.0",
  "description": "9:16 explainer reel starter — Remotion motion graphics + ElevenLabs narration",
  "repository": {},
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.ts Reel out/reel.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k --sample-rate=48000",
    "still": "remotion still src/index.ts Reel out/cover.png --frame=30",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "check": "npm run lint && node scripts/check-timeline.mjs",
    "voiceover": "node scripts/generate-voiceover.mjs",
    "audio": "node scripts/generate-audio.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
